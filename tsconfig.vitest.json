{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "coverage"
  ]
}
